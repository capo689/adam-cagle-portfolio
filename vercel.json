{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.adamcagle.com" }],
      "destination": "https://adamcagle.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "adam-cagle-portfolio.vercel.app" }],
      "destination": "https://adamcagle.com/$1",
      "permanent": true
    },
    { "source": "/brain/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/launch/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/dev", "destination": "/DEV", "permanent": false },
    { "source": "/dev/:path*", "destination": "/DEV/:path*", "permanent": false },
    { "source": "/natasha", "destination": "/natasha/index.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/natasha",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/natasha/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
