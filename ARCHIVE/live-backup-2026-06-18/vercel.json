{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.adamcagle.com" }],
      "destination": "https://adamcagle.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "adam-cagle-portfolio.vercel.app" }],
      "destination": "https://adamcagle.com/$1",
      "permanent": true
    },
    { "source": "/brain/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/launch/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/dev", "destination": "/DEV", "permanent": false },
    { "source": "/dev/:path*", "destination": "/DEV/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!img/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
